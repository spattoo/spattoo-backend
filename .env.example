# Copy to .env for local development — never commit .env
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
# ⚠️ DEAD ON 1 DECEMBER 2026, 09:00 CET — the self-service API stops accepting requests and unused
# credits expire the same morning. Set only if an environment still holds credits to spend.
REMOVE_BG_API_KEY=

# Where the remove.bg API went: Leonardo.Ai (Canva-owned, separate account, keys do NOT carry over).
# app.leonardo.ai → API Access. ~$0.1047 an image; the real figure comes back on every response.
LEONARDO_API_KEY=

# Which provider cuts backgrounds out: leonardo (default) | removebg (dead after 1 Dec) | self
# (spattoo-bgremover, free per image, needs the Render private service deployed first).
# BG_REMOVAL_PROVIDER=leonardo
# Which PAID vendor answers when provider=self and our own service cannot.
# BG_REMOVAL_VENDOR=leonardo
MESHY_API_KEY=
REDIS_URL=
PORT=3000

# Upload ceilings, in MB, per kind of asset (optional — these are the defaults). Enforced by SIGNING the
# length into the presigned URL, and served to the browser via GET /api/storage/limits so the client
# refuses an oversized file at pick time against the SAME number. Retune in Render; no deploy needed.
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_MODEL_MB=75
UPLOAD_MAX_FONT_MB=5

# ── SMS OTP delivery (MSG91) ────────────────────────────────────────────────────────────────────
# Optional. Only read when Supabase's Send SMS hook fires, which needs `sms` in
# STOREFRONT_OTP_CHANNELS. MSG91 DELIVERS the code; Supabase still mints and verifies it.
MSG91_AUTH_KEY=
# OTP template from the MSG91 panel. Without DLT clearance, use the default template in channel
# settings — it sends, but carries no branding and logs nothing in the panel's OTP section.
MSG91_TEMPLATE_ID=
# From Supabase → Authentication → Hooks → Send SMS. Paste verbatim, including the `v1,whsec_`.
SEND_SMS_HOOK_SECRET=

# Which channels a storefront visitor may verify on: sms | email (comma-separated, first = offered
# first). Defaults to email alone. Add `sms` only once MSG91 delivery is proven — an offered but
# undeliverable channel is worse than none, because the customer picks it and waits for nothing.
STOREFRONT_OTP_CHANNELS=email
