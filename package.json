{
  "name": "spattoo-api",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:schema": "node scripts/check-schema.mjs",
    "check:admin-routes": "node scripts/check-admin-routes.mjs",
    "check:feature-docs": "node ../spattoo-docs/bin/check-feature-docs.mjs --repo spattoo-api",
    "check": "npm run check:schema && npm run check:admin-routes && npm run check:feature-docs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1036.0",
    "@sentry/node": "^10.60.0",
    "@supabase/supabase-js": "^2.103.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ioredis": "^5.3.2",
    "libphonenumber-js": "^1.13.7",
    "nodemailer": "^8.0.10",
    "onnxruntime-node": "^1.27.0",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
