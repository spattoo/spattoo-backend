{
  "name": "spattoo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:boot": "node scripts/check-boot.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:occasions": "node ../spattoo-docs/bin/check-occasions.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:admin-routes": "node scripts/check-admin-routes.mjs",
    "check:object-keys": "node scripts/check-object-keys.mjs",
    "check:xray-spec": "node scripts/check-xray-spec.mjs",
    "check:ai-credit-pricing": "node scripts/check-ai-credit-pricing.mjs",
    "check:dup": "jscpd src",
    "check:feature-docs": "node ../spattoo-docs/bin/check-feature-docs.mjs --repo spattoo-api",
    "check": "npm run check:migrations && npm run check:occasions && npm run check:boot && npm run check:schema && npm run check:admin-routes && npm run check:object-keys && npm run check:xray-spec && npm run check:ai-credit-pricing && npm run check:match-confidence && npm run check:sale-events && npm run check:credit-alerts && npm run check:bg-fallback && npm run check:decoration-policy && npm run check:build-guide-roles && npm run check:gst && npm run check:print-sheets && npm run check:likeness && npm run check:premium-themes && npm run check:delivery-digest && npm run check:trial-reminders && npm run check:shape-promotion && npm run check:dietary-egg && npm run check:push-copy && npm run check:email-design-claims && npm run check:dup && npm run check:feature-docs",
    "check:match-confidence": "node scripts/check-match-confidence.mjs",
    "check:sale-events": "node scripts/check-sale-events.mjs",
    "check:credit-alerts": "node scripts/check-credit-alerts.mjs",
    "check:bg-fallback": "node scripts/check-bg-fallback.mjs",
    "check:gst": "node scripts/check-gst.mjs",
    "check:print-sheets": "node scripts/check-print-sheets.mjs",
    "check:premium-themes": "node scripts/check-premium-themes.mjs",
    "check:likeness": "node scripts/check-likeness.mjs",
    "check:delivery-digest": "node scripts/check-delivery-digest.mjs",
    "check:trial-reminders": "node scripts/check-trial-reminders.mjs",
    "check:shape-promotion": "node scripts/check-shape-promotion.mjs",
    "check:push-copy": "node scripts/check-push-copy.mjs",
    "check:email-design-claims": "node scripts/check-email-design-claims.mjs",
    "check:plan-copy": "node ../spattoo-docs/bin/check-plan-copy.mjs",
    "verify:ai-credit-buckets": "node scripts/verify-ai-credit-buckets.mjs",
    "db:schema": "node scripts/dump-schema.mjs",
    "db:migrations": "node scripts/migrations.mjs",
    "db:schema:check": "node scripts/dump-schema.mjs --check",
    "db:seed-lookups": "node scripts/seed-lookups.mjs",
    "db:seed-lookups:sql": "node scripts/seed-lookups-sql.mjs",
    "db:verify-library": "node scripts/verify-prod-library.mjs",
    "verify:razorpay-plans": "node scripts/verify-razorpay-plans.mjs",
    "check:decoration-policy": "node scripts/check-decoration-policy.mjs",
    "check:build-guide-roles": "node scripts/check-build-guide-roles.mjs",
    "check:dietary-egg": "node scripts/check-dietary-egg.mjs",
    "check:demo-request": "node scripts/check-demo-request.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1036.0",
    "@sentry/node": "^10.60.0",
    "@supabase/supabase-js": "^2.103.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.3.2",
    "libphonenumber-js": "^1.13.7",
    "nodemailer": "^8.0.10",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.2",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "jscpd": "5.0.16",
    "nodemon": "^3.1.0"
  }
}
