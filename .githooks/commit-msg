#!/bin/sh
# Feature-doc liveness gate — see spattoo-docs/README.md
# Blocks a commit that changes code an owning feature doc covers without also
# updating that doc. Honors [skip-feature-doc] in the commit message.
# Tracked hook: activated via `git config core.hooksPath .githooks` (npm run prepare).
DOCS_DIR="${SPATTOO_DOCS_DIR:-$(git rev-parse --show-toplevel)/../spattoo-docs}"
BIN="$DOCS_DIR/bin/check-feature-docs.mjs"
[ -f "$BIN" ] || { echo "ℹ spattoo-docs not found next to repo — skipping feature-doc gate"; exit 0; }
COMMIT_MSG_FILE="$1" node "$BIN" --repo spattoo-api
